{
  "name": "anden",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.148.0"
  },
  "main": "./out/extension",
  "extensionKind": ["ui"],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%untrustedWorkspaces.description%"
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "anden",
          "title": "%displayName%",
          "icon": "media/anden.svg"
        }
      ]
    },
    "views": {
      "anden": [
        {
          "id": "anden.sessions",
          "name": "%sessions.title%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "anden.sessions",
        "contents": "%sessions.welcome%"
      }
    ],
    "commands": [
      {
        "command": "anden.newSession",
        "title": "%newSession.title%",
        "category": "%displayName%",
        "icon": "$(add)"
      },
      {
        "command": "anden.switchSession",
        "title": "%switchSession.title%",
        "category": "%displayName%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "anden.newSession",
          "when": "view == anden.sessions",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "anden.switchSession",
        "key": "ctrl+k j",
        "mac": "cmd+k j",
        "when": "anden.hasSessions && !inQuickOpen"
      }
    ],
    "configuration": {
      "title": "%displayName%",
      "properties": {
        "anden.pi.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%pi.executablePath.description%"
        },
        "anden.codex.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%codex.executablePath.description%"
        }
      }
    }
  }
}
